# Allow only runtime source and build inputs. Keep host credentials, DBs, backups
# and existing emitted code out of the build context and the resulting image.
**
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!.npmrc
!.eslintrc.json
!.eslintignore
!tsconfig*.json
!tailwind.config.js
!postcss.config.js
!turbo.json
!types/**
!packages/*/package.json
!packages/*/tsconfig*.json
!packages/api/src/**
!packages/shared/src/**
!packages/design-tokens/src/**
!packages/ui/src/**
!packages/api/types.ts
!packages/api/prisma/schema.prisma
!packages/api/prisma/prepare-sqlite.cjs
!packages/api/prisma/sqlite/**
!packages/api/prisma/seed.ts
!packages/api/prisma/migrations/**
!packages/design-tokens/config.json
!packages/design-tokens/style-dictionary.config.js
!packages/ui/global.css
!packages/ui/tsup.config.ts
!apps/web/package.json
!apps/web/app/**
!apps/web/src/**
!apps/web/lib/**
!apps/web/public/**
!apps/web/.eslintrc.json
!apps/web/*.config.js
!apps/web/next-env.d.ts
!apps/web/middleware.ts
!apps/web/tsconfig.json
!apps/api-legacy/package.json
!apps/fx-free/package.json
!scripts/verify-build-artifacts.mjs
!deploy/lan/initialize.cjs
!deploy/lan/sqlite/*.py
!deploy/lan/sqlite/*.sql
**/node_modules
**/.env*
**/.next
**/.turbo
**/dist
**/*.tsbuildinfo
**/__tests__
**/*.spec.ts
**/*.test.ts
**/*.bak
