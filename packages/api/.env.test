# Test Environment Variables
NODE_ENV=test

# Test Database (use isolated test DB)
DATABASE_URL="postgresql://entrip:entrip@localhost:5432/entrip_test"
TEST_DATABASE_URL="postgresql://entrip:entrip@localhost:5432/entrip_test"

# JWT Secrets for Testing
JWT_SECRET=test-jwt-secret-key
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key
JWT_EXPIRES_IN=1h

# API Configuration
PORT=4003
API_VERSION=v2

# CORS
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
