# Server Configuration
PORT=4000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/entrip

# JWT Secret (Future)
# JWT_SECRET=your-secret-key-here

# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://entrip_user:entrip_password@localhost:5432/entrip_db"

# Schema Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL=30          # 검사 주기 (분)
MONITORING_AUTOFIX=true         # 자동 수정 활성화
MONITORING_ALERT=true           # 알림 활성화

# Alert Configuration
ALERTS_ENABLED=true
ALERT_MIN_SEVERITY=MEDIUM       # HIGH, MEDIUM, LOW
ALERT_INTERVAL=60               # 동일 알림 재발송 방지 (분)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ALERT_EMAILS=admin@entrip.com,dev@entrip.com