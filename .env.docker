# Docker Compose 로컬 개발 환경 변수
# docker-compose.local.yml에서 사용

# Database Configuration
POSTGRES_USER=entrip
POSTGRES_PASSWORD=entrip
POSTGRES_DB=entrip
DATABASE_URL=postgres://entrip:entrip@postgres:5432/entrip

# JWT Configuration  
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API v1 Configuration (apps/api)
PORT=4000
NODE_ENV=production
FRONT_URL=http://localhost:3000

# API v2 Configuration (packages/api)
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_API_V2_URL=http://localhost:4002
INTERNAL_API_URL=http://api:4000
INTERNAL_API_V2_URL=http://api-v2:4002
NEXT_PUBLIC_CRAWLER_API_URL=http://crawler:8001
NEXT_TELEMETRY_DISABLED=1

# Development Settings
NEXT_PUBLIC_API_MOCKING=disabled

# API Keys (set your actual values)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=
EXIM_API_KEY=
SKYSCANNER_API_KEY=
ODCLOUD_API_KEY=

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# External Services
BANK_API_URL=
BANK_API_KEY=
OCR_API_KEY=
SMS_API_KEY=
FAX_API_KEY=

# Monitoring Configuration
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Docker Environment
COMPOSE_PROJECT_NAME=entrip

# Schema Monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL=30
MONITORING_AUTOFIX=true
MONITORING_ALERT=true
ALERTS_ENABLED=true
ALERT_MIN_SEVERITY=MEDIUM
ALERT_INTERVAL=60
SCHEMA_CASE_INSENSITIVE=false