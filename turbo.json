{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "bundle": {
      "dependsOn": [
        "^bundle"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": false
    },
    "@entrip/ui#bundle": {
      "outputs": [
        "dist/**"
      ]
    },
    "@entrip/ui#dev": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "@entrip/web#dev": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "@entrip/web#bundle": {
      "dependsOn": [
        "^bundle"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_APP_VERSION",
    "INTERNAL_API_V2_URL",
    "API_V2_URL"
  ]
}
